# Python
__pycache__/
*.pyc
*.pyo
.Python

# Virtual environments — never commit these (the old repo had a full .venv checked in)
venv/
.venv/
env/

# Model checkpoints — trained on Kaggle, pulled from HF Hub at runtime.
# Never commit these; they bloat the repo and go stale immediately.
checkpoints/*
!checkpoints/.gitkeep
*.pt
*.pth
*.ckpt

# Runtime upload scratch space
uploads/*
!uploads/.gitkeep

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Raw text datasets — large/curated data files, don't belong in git.
# requirements.txt is explicitly excluded from this rule.
*.txt
!requirements.txt

# Kaggle/local training scratch
dataset_raw/
*.png
!static/**/*.png
